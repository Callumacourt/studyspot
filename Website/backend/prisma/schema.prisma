// This is our database file
// learn more about it in the docs: https://pris.ly/d/prisma-schema
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Just used to specify what metric the sensor reading is for
enum MetricType {
  TEMP
  HUMIDITY
  NOISE
  OCCUPANCY
}

model User {
  userId Int @id @default(autoincrement())
  email String @unique
  password String // make sure we hash this before storing
  favouritedRooms Room[]
}

model University {
  id Int @id @default(autoincrement())
  name String @unique
  buildings Building []
}

model Building {
  id Int @id @default(autoincrement())
  universityId Int
  university University @relation(fields: [universityId], references: [id])
  name String
  rooms Room []

  @@unique([universityId, name])
}

model Room {
  id Int @id @default(autoincrement())
  readings SensorReading[]
  buildingId Int
  building Building @relation(fields: [buildingId], references: [id])
  name String
  occupancyAverages OccupancyAverage[]
  sensors Sensor []
  favouritedByUsers User []

  wheelchairAccessible Boolean @default(false)
  hasAdjustableDesks Boolean @default(false)
  groundFloor Boolean @default(false)
  hearingAssistance Boolean @default(false)

  @@unique([buildingId, name])
}

model SensorReading {
  readingId Int @id @default(autoincrement())
  roomId Int
  room Room @relation(fields: [roomId], references: [id])
  metricType MetricType
  value Float
  time DateTime
}

// Average amount of people in a room at a given hour on a given day
model OccupancyAverage {
  id Int @id @default(autoincrement())
  roomId Int
  room Room @relation(fields: [roomId], references: [id])
  dayOfWeek Int // 0 = Monday, 1 = Tues ... 7 = Sunday
  hour Int // 0 = midnight, 1 = 1AM ... etc
  averageOccupancy Int
}

model Sensor {
  sensorId Int @id @default(autoincrement())
  roomId Int
  room Room @relation(fields: [roomId], references: [id])
  name String?
  deviceId String? // thingsboard device ID
}

