// This is our database file
// learn more about it in the docs: https://pris.ly/d/prisma-schema
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Just used to specify what metric the sensor reading is for
enum MetricType {
  TEMP
  HUMIDITY
  NOISE
  OCCUPANCY
  LIGHT
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum ReportCategory {
  DATA_QUALITY
  SAFETY
  ACCESSIBILITY
  OTHER
}

enum UserRole {
  USER
  UNIVERSITY_ADMIN
  SUPER_ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model User {
  userId Int @id @default(autoincrement())
  email String @unique
  password String // make sure we hash this before storing
  role UserRole @default(USER)
  managedUniversityId Int?
  managedUniversity University? @relation("ManagedUniversityAdmins", fields: [managedUniversityId], references: [id])
  favouritedRooms Room[]
  roomReports RoomReport[]
}

model University {
  id Int @id @default(autoincrement())
  name String @unique
  buildings Building []
  administrators User[] @relation("ManagedUniversityAdmins")
}

model Building {
  id Int @id @default(autoincrement())
  universityId Int
  university University @relation(fields: [universityId], references: [id])
  name String
  rooms Room []

  @@unique([universityId, name])
}

model Room {
  id Int @id @default(autoincrement())
  readings SensorReading[]
  buildingId Int
  building Building @relation(fields: [buildingId], references: [id])
  name String
  occupancyAverages OccupancyAverage[]
  sensors Sensor []
  favouritedByUsers User []
  reports RoomReport[]

  bookable Boolean @default(false)
  maxBookingDurationMinutes Int?
  openHour DateTime?
  closeHour DateTime?
  bookings RoomBooking[]

  wheelchairAccessible Boolean @default(false)
  hasAdjustableDesks Boolean @default(false)
  groundFloor Boolean @default(false)
  hearingAssistance Boolean @default(false)

  @@unique([buildingId, name])
}

model RoomBooking {
  id Int @id @default(autoincrement())
  roomId Int
  room Room @relation(fields: [roomId], references: [id])
  startTime DateTime
  endTime DateTime
  status BookingStatus @default(PENDING)
}

model RoomReport {
  id Int @id @default(autoincrement())
  roomId Int
  room Room @relation(fields: [roomId], references: [id])
  reporterUserId Int?
  reporterUser User? @relation(fields: [reporterUserId], references: [userId])
  category ReportCategory @default(OTHER)
  message String
  status ReportStatus @default(OPEN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roomId, status])
  @@index([reporterUserId])
}

model SensorReading {
  readingId Int @id @default(autoincrement())
  roomId Int
  room Room @relation(fields: [roomId], references: [id])
  metricType MetricType
  value Float
  time DateTime
}

// Average amount of people in a room at a given hour on a given day
model OccupancyAverage {
  id Int @id @default(autoincrement())
  roomId Int
  room Room @relation(fields: [roomId], references: [id])
  dayOfWeek Int // 0 = Monday, 1 = Tues ... 7 = Sunday
  hour Int // 0 = midnight, 1 = 1AM ... etc
  averageOccupancy Int
}

model Sensor {
  sensorId Int @id @default(autoincrement())
  roomId Int
  room Room @relation(fields: [roomId], references: [id])
  name String?
  deviceId String? // thingsboard device ID
}

